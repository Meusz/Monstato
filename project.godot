; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Roguelite Survivor"
config/description="A survival roguelite with 20-30 minute runs, wave-based combat, and strategic character progression."
config/version="0.1.0"
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
DataBus="*res://core/data_bus.gd"
GameManager="*res://core/game_manager.gd"
AudioManager="*res://core/audio_manager.gd"
SaveSystem="*res://core/save_system.gd"
EnemyDatabase="*res://enemies/enemy_database.gd"
WeaponDatabase="*res://weapons/weapon_database.gd"
ItemDatabase="*res://items/item_database.gd"
UpgradeSystem="*res://ui/upgrade/upgrade_system.gd"
ParticleManager="*res://effects/particle_manager.gd"
AchievementSystem="*res://save/unlocks/achievement_system.gd"
ShopSystem="*res://economy/shop_system.gd"
CompanionDatabase="*res://companions/companion_database.gd"
AdManager="*res://ads/ad_manager.gd"
TrainerAbilities="*res://abilities/trainer_abilities.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

