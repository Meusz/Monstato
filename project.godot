[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="PlayerProjectiles"
2d_physics/layer_4="EnemyProjectiles"
2d_physics/layer_5="Items"
2d_physics/layer_6="Walls"
2d_physics/layer_7="Pickups"
2d_physics/layer_8="UI"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
